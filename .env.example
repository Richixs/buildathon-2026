DATABASE_URL="postgresql://pollar_track:pollar_track@localhost:5432/pollar_track?schema=public"

# Reown AppKit project ID — create one at https://cloud.reown.com
NEXT_PUBLIC_PROJECT_ID=""

# Public URL of the app, used in the wallet-connect metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Chain where the EquityEscrowFactory lives: 133 = HashKey testnet,
# 177 = HashKey mainnet. Must be one of the networks in config/wagmi.ts.
NEXT_PUBLIC_ESCROW_CHAIN_ID="133"

# Address printed by `npm run deploy:testnet` in contracts/. Without it,
# campaigns can be saved as DRAFT but never deployed or activated.
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=""

# Optional, server-only: RPC used by the API to verify txs and sync
# escrow state. Defaults to the public RPC of NEXT_PUBLIC_ESCROW_CHAIN_ID.
ESCROW_RPC_URL=""
