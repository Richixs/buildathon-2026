# Deployer wallet for `pnpm deploy:testnet` / `pnpm deploy:mainnet` — must
# hold testnet/mainnet HSK for gas. NEVER commit the real value.
PRIVATE_KEY=""

# Address that becomes `owner()` on the deployed EquityEscrowFactory (and
# therefore the admin/oracle on every EquityEscrow it creates). Defaults to
# the deployer's own address in scripts/deploy-factory.ts if left unset.
ADMIN_ADDRESS=""

# Optional RPC overrides — defaults to the verified public endpoints in
# hardhat.config.ts (testnet.hsk.xyz / mainnet.hsk.xyz).
HSK_TESTNET_RPC_URL=""
HSK_MAINNET_RPC_URL=""
